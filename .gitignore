############################################################
# 依存・ビルド成果物（Node.js / Vite / TypeScript）
############################################################
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

############################################################
# テスト結果（Vitest / Playwright）
############################################################
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
/.vitest/

############################################################
# ログ
############################################################
*.log
npm-debug.log*

############################################################
# 環境変数
############################################################
# VITE_ 付きの値はビルド成果物に埋め込まれる。秘密情報は置かない（SECURITY.md）
.env
.env.*

############################################################
# 秘密情報・認証情報・個人のデータ（公開リポジトリに絶対に含めない。CONTRIBUTING.md）
############################################################
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
*.kdbx
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials*.json
service-account*.json
*.secret
*.secrets
.netrc
*.local
# 通信内容・Cookie を含みうる記録（Playwright のトレースなど）
*.har
trace.zip
# 個人のメモ
*.local.md
/.private/

############################################################
# AI エージェント（Claude Code・Codex）の手元専用の設定
############################################################
# プレビュー用の launch.json、個人の settings.local.json、作業メモなど
# AI エージェントへの決まりは CONTRIBUTING.md の「AI エージェントに作業させるとき」に書き、ツールの設定は共有しない
.claude/
.codex/

